<?xml version="1.0"?>
<ruleset name="LS Starter Plugin">
	<description>PHPCS ruleset for the LS Starter Plugin.</description>

	<file>.</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>

	<!--
	The main plugin file is a scaffold placeholder named {{PLUGIN_SLUG}}.php.
	It is renamed to the real plugin slug at scaffold time, so the
	WordPress.Files.FileName sniff can never be satisfied in template form.
	Excluded for this one file only; the sniff still applies everywhere else.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>^\{\{PLUGIN_SLUG\}\}\.php$</exclude-pattern>
	</rule>

	<config name="testVersion" value="8.0-"/>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
